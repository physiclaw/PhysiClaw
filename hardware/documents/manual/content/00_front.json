    "entries": [
      {
        "src": "fastener_11_SHCS_assembled_cam1.svg",
        "h3": {
          "en": "Socket head cap screw (SHCS)",
          "zh": "内六角圆柱头螺栓（SHCS）"
        },
        "body": {
          "en": "Cylindrical head, hex drive.",
          "zh": "圆柱头，内六角驱动。"
        },
        "ref": {
          "en": "ISO 4762 / DIN 912",
          "zh": "ISO 4762 / DIN 912"
        }
      },
      {
        "src": "fastener_10_BHCS_assembled_cam1.svg",
        "h3": {
          "en": "Button head cap screw (BHCS)",
          "zh": "内六角半圆头螺栓（BHCS）"
        },
        "body": {
          "en": "Domed head, hex drive. Use it where you need a low head but not a flush head.",
          "zh": "半圆头，内六角驱动。用于需要低螺栓头、但不要求齐平的位置。"
        },
        "ref": {
          "en": "ISO 7380-1",
          "zh": "ISO 7380-1"
        }
      },
      {
        "src": "fastener_12_FHCS_assembled_cam1.svg",
        "h3": {
          "en": "Flat head cap screw (FHCS)",
          "zh": "内六角沉头螺栓（FHCS）"
        },
        "body": {
          "en": "90° countersunk head, hex drive. The head sits flush with the surface. Use it where nothing can protrude above the part.",
          "zh": "90° 沉头，内六角驱动。螺栓头与表面齐平。用于零件表面不允许有凸起的位置。"
        },
        "ref": {
          "en": "ISO 10642 / DIN 7991",
          "zh": "ISO 10642 / DIN 7991"
        }
      },
      {
        "src": "fastener_40_shim_assembled_cam1.svg",
        "h3": {
          "en": "Shim",
          "zh": "垫片"
        },
        "body": {
          "en": "5×8×0.5 shim. Stack shims under each idler to adjust axial play.",
          "zh": "5×8×0.5 垫片。叠在每个惰轮下面，调整轴向间隙。"
        },
        "ref": {
          "en": "5×8×0.5",
          "zh": "5×8×0.5"
        }
      },
      {
        "src": "fastener_21_hex_nut_assembled_cam1.svg",
        "h3": {
          "en": "Hex nut",
          "zh": "六角螺母"
        },
        "body": {
          "en": "Pairs with a screw to clamp parts firmly together.",
          "zh": "与螺栓配合，把零件牢固夹紧。"
        },
        "ref": {
          "en": "ISO 4032 / DIN 934",
          "zh": "ISO 4032 / DIN 934"
        }
      },
      {
        "src": "fastener_20_square_nut_assembled_cam1.svg",
        "h3": {
          "en": "Square nut",
          "zh": "四方螺母"
        },
        "body": {
          "en": "A square nut sits in a pocket of the printed part, so that a screw can thread into it.",
          "zh": "四方螺母嵌在打印件的方槽内，供螺栓拧入。"
        },
        "ref": {
          "en": "DIN 557",
          "zh": "DIN 557"
        }
      }
    ]
  },
  {
