    "entries": [
      {
        "src": "fastener_22_tnut_standard_assembled_cam1.svg",
        "h3": {
          "en": "Standard T-nut (slide-in)",
          "zh": "滑块 T 型螺母（端部滑入）"
        },
        "body": {
          "en": "Slides into the slot from the open end of the extrusion. When you tighten the screw, the nut pulls up and catches on the inner edges of the slot.",
          "zh": "从型材开口端滑入槽内。拧紧螺栓时，螺母向上提起，卡在槽口内侧边缘。"
        }
      },
      {
        "src": "fastener_23_tnut_hammer_assembled_cam1.svg",
        "h3": {
          "en": "Hammer T-nut (drop-in)",
          "zh": "船形 T 型螺母（任意位置放入）"
        },
        "body": {
          "en": "Drops flat into the slot anywhere along its length. A quarter turn then locks it.",
          "zh": "在型材的任意位置平放入槽内。旋转 90° 即卡紧。"
        }
      },
      {
        "src": "fastener_30_pulley_assembled_cam1.svg",
        "h3": {
          "en": "GT2 drive pulley",
          "zh": "GT2 同步轮"
        },
        "body": {
          "en": "20-tooth pulley. One sits on each motor shaft, locked to the D-flat with a set screw. It drives the GT2 belt.",
          "zh": "20 齿同步轮。每根电机轴上装一个，用紧定螺钉顶住轴的 D 形切面锁紧。同步轮带动 GT2 同步带。"
        },
        "ref": {
          "en": "GT2 · 20T · 5 mm bore · 6 mm belt",
          "zh": "GT2 · 20 齿 · 孔径 5 mm · 带宽 6 mm"
        }
      },
      {
        "src": "fastener_31_idler_assembled_cam1.svg",
        "h3": {
          "en": "GT2 idler (toothed)",
          "zh": "GT2 惰轮（带齿）"
        },
        "body": {
          "en": "Toothed wheel that meshes with the toothed side of the belt.",
          "zh": "带齿惰轮，与同步带的齿面啮合。"
        },
        "ref": {
          "en": "GT2 · 20T · 5 mm bore · 6 mm belt",
          "zh": "GT2 · 20 齿 · 孔径 5 mm · 带宽 6 mm"
        }
      },
      {
        "src": "fastener_32_idler_smooth_assembled_cam1.svg",
        "h3": {
          "en": "GT2 idler (smooth)",
          "zh": "GT2 惰轮（光面）"
        },
        "body": {
          "en": "Smooth wheel that rides on the flat back of the belt.",
          "zh": "光面惰轮，贴着同步带的平背面滚动。"
        },
        "ref": {
          "en": "5 mm bore · 6 mm belt",
          "zh": "孔径 5 mm · 带宽 6 mm"
        }
      },
      {
        "src": "fastener_41_flat_bracket_assembled_cam1.svg",
        "h3": {
          "en": "Flat bracket",
          "zh": "一字连接板"
        },
        "body": {
          "en": "2-hole plate with M5 holes 20 mm apart.",
          "zh": "2 孔平板，M5 孔间距 20 mm。"
        }
      }
    ]
  },
