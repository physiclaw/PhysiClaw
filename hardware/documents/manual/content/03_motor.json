    "notes": [
      {
        "h3": {
          "en": "Note the connector direction",
          "zh": "注意接线端子的朝向"
        },
        "body": {
          "en": "Make sure that the motor connector faces as shown. That direction sets the wiring clearance later.",
          "zh": "确认电机接线端子朝向与图一致。朝向决定后续布线的空间。"
        },
        "classes": "note overlay sm",
        "style": "left:130mm; top:130mm; width:80mm;"
      },
      {
        "h3": {
          "en": "Spacer height for Motor A",
          "zh": "电机 A 的轴套高度"
        },
        "body": {
          "en": "The spacer of Motor A must be 8 mm tall.",
          "zh": "电机 A 的轴套高度必须为 8 mm。"
        },
        "classes": "note overlay sm",
        "style": "left:100mm; top:20mm; width:80mm;"
      },
      {
        "h3": {
          "en": "Tighten in a cross pattern",
          "zh": "按对角顺序拧紧"
        },
        "body": {
          "en": "1. Thread all 4 motor screws in by hand. 2. Tighten opposite corners in pairs. This pulls the motor flat against the bracket.",
          "zh": "1. 先用手拧上 4 颗电机螺栓。2. 按对角成对拧紧。这样电机才能平贴支架。"
        },
        "classes": "note overlay sm",
        "style": "left:125mm; top:75mm; width:70mm;"
      }
    ],
