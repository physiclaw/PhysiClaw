    "main": {
      "src": "linear_11_y_exploded_cam1_xjoj.svg"
    },
    "notes": [
      {
        "h3": {
          "en": "Rail ends against the idler mounts",
          "zh": "导轨端面紧靠惰轮支座"
        },
        "body": {
          "en": "Adjust the idler mounts at the end opposite the motors. Make sure that both Y rail ends sit tight against them.",
          "zh": "调整远离电机一侧的惰轮支座。确认两根 Y 导轨的末端都紧靠支座。"
        },
        "classes": "note overlay sm",
        "style": "right:5mm; top:0mm; width:60mm;"
      },
      {
        "h3": {
          "en": "Do not fully tighten the Y rails",
          "zh": "Y 导轨暂不拧紧"
        },
        "body": {
          "en": "Tighten the screws of both Y rails until snug. Install the X beam first. When it slides smoothly, tighten them fully.",
          "zh": "两根 Y 导轨的螺栓只拧到贴合。先装 X 横梁。横梁滑动顺畅后，再拧紧。"
        },
        "classes": "note overlay sm",
        "style": "right:16mm; top:120mm; width:80mm;"
      }
    ],
    "notesInside": true
  },
