    "notes": [
      {
        "h3": {
          "en": "Thread on the camera",
          "zh": "拧上摄像头"
        },
        "body": {
          "en": "Thread the camera's 1/4-20 female thread onto the gooseneck's male stud until it stops against the collar.",
          "zh": "把摄像头的 1/4-20 内螺纹拧到金属软管的外螺纹螺柱上，直到顶住台肩。"
        },
        "classes": "note overlay sm",
        "style": "left:140mm; top:80mm; width:60mm;"
      }
    ],
