  {
    "type": "main-inset-br",
    "page": "camera_40",
    "head": {
      "title": {
        "en": "CAMERA",
        "zh": "摄像头"
      },
      "small": "camera_40"
    },
    "main": {
      "src": "camera_40_frame_assembled_cam1_mxqc.svg",
      "style": "transform: translateX(-35mm);"
    },
    "notes": [
      {
        "h3": {
          "en": "Use the lower slot",
          "zh": "用下方的型材槽"
        },
        "body": {
          "en": "Install the corner bracket in the lower slot of the right extrusion's outer face.",
          "zh": "把角码装进右侧型材外侧面的下方型材槽。"
        },
        "classes": "note overlay sm",
        "style": "right:10mm; top:30mm; width:80mm;"
      },
      {
        "h3": {
          "en": "Orient the camera",
          "zh": "调整摄像头朝向"
        },
        "body": {
          "en": "Bend the gooseneck so that the camera points squarely at the phone screen. Align the sensor's long edge with the phone's long edge.",
          "zh": "弯折金属软管，使摄像头正对手机屏幕。把传感器长边与手机长边对齐。"
        },
        "classes": "note overlay sm",
        "style": "right:10mm; top:80mm; width:80mm;"
      },
      {
        "h3": {
          "en": "Check the camera",
          "zh": "检查摄像头"
        },
        "body": {
          "en": "Make sure that the camera does not drift or wobble.",
          "zh": "确认摄像头固定牢靠，不会移位或晃动。"
        },
        "classes": "note overlay sm",
        "style": "right:10mm; top:140mm; width:80mm;"
      },
      {
        "h3": {
          "en": "Route the USB cable",
          "zh": "USB 线走线"
        },
        "body": {
          "en": "Tie the camera's USB cable along the gooseneck with cable ties, clear of the belt.",
          "zh": "用捆扎带把摄像头的 USB 线沿金属软管固定，避免碰到同步带。"
        },
        "classes": "note overlay sm",
        "style": "left:16mm; top:20mm; width:70mm;"
      }
    ]
  }
]
