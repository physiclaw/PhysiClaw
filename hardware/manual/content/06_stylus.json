      }
    ],
    "notes": [
      {
        "h3": {
          "en": "Install the stylus tip",
          "zh": "安装触控笔尖"
        },
        "body": {
          "en": "The solenoid ships with a nut on its bottom end. 1. Remove the nut. 2. Thread the stylus tip on in its place.",
          "zh": "电磁铁底端出厂时拧有一颗螺母。1. 拧下螺母。2. 在原位拧上触控笔尖。"
        },
        "classes": "note overlay sm",
        "style": "left:120mm; top:60mm; width:60mm;"
      },
      {
        "h3": {
          "en": "Make the leads longer",
          "zh": "先接长引线"
        },
        "body": {
          "en": "Before you install the solenoid on the mount, make the positive and negative leads longer. Refer to Wiring — Extend the leads.",
          "zh": "把电磁铁装到支架上之前，先接长正负极引线。方法见“接线 — 接长引线”。"
        },
        "classes": "note overlay sm",
        "style": "left:120mm; top:105mm; width:60mm;"
      }
    ],
    "bom": {
      "label": {
        "en": "Bill of materials",
        "zh": "物料清单"
      },
      "rows": [
        {
          "component": {
            "en": "Solenoid",
            "zh": "推拉式电磁铁"
          },
          "spec": {
            "en": "12 V, 2×M3, 15 mm pitch",
            "zh": "12 V，2×M3，孔距 15 mm"
          },
